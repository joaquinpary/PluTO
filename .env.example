# Also signs the API's JWTs: use a long random value (50+ characters), e.g.
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pluto
POSTGRES_USER=pluto
POSTGRES_PASSWORD=change-me
# Changing POSTGRES_USER/POSTGRES_PASSWORD requires recreating the database volume:
#   docker compose down && docker volume rm pluto_postgres-data
# POSTGRES_* only initialize an empty data directory.

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=pluto
MQTT_PASSWORD=change-me

# Where plugin containers reach the server's /api/ (optional, this is the default).
# PLUTO_API_URL=http://server:8000/api/

# Origins allowed to call /api/ from a browser, comma-separated (the front end).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
